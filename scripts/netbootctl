#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT/config/netboot.env"
RENDERER="$SCRIPT_DIR/render-netboot-config.py"
RUNTIME="$NETBOOT_RUNTIME_ROOT"
GENERATED="$NETBOOT_GENERATED_ROOT"
LOGS="$NETBOOT_LOG_ROOT"
STATE="$RUNTIME/state"

usage() {
	cat <<'EOF'
Usage: netbootctl <command>

Commands:
  render        Render and validate repository-local service configuration
  start         Start Caddy and dnsmasq as standalone daemons
  stop          Stop dnsmasq and Caddy safely
  restart       Stop and start both daemons
  reload        Render, validate, and reload/restart configuration
  status        Show verified daemon and listener state
  logs          Follow repository-local service logs
  tui [options] Launch the netboot visibility TUI
  help          Show this help
EOF
}

need_root() {
	if ((EUID != 0)); then
		exec sudo "$0" "$@"
	fi
}

require_command() { command -v "$1" >/dev/null 2>&1 || {
	echo "Missing required command: $1" >&2
	return 1
}; }
prepare_runtime() { install -d -m 0755 "$RUNTIME" "$GENERATED" "$LOGS" "$STATE"; }
render_config() {
	require_command python3
	python3 "$RENDERER"
}
record_path() { printf '%s/%s.record\n' "$STATE" "$1"; }
proc_cmdline() { tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null | sed 's/[[:space:]]*$//'; }
proc_exe() { readlink -f "/proc/$1/exe" 2>/dev/null || true; }
proc_pgid() { ps -o pgid= -p "$1" 2>/dev/null | tr -d ' '; }

write_record() {
	local name=$1 pid=$2 expected_exe=$3 config=$4 record tmp cmd pgid
	record=$(record_path "$name")
	cmd=$(proc_cmdline "$pid")
	pgid=$(proc_pgid "$pid")
	[[ -n "$cmd" && -n "$pgid" ]] || {
		echo "Unable to inspect $name daemon $pid" >&2
		return 1
	}
	[[ "$(proc_exe "$pid")" == "$(readlink -f "$expected_exe")" ]] || {
		echo "$name did not exec expected binary" >&2
		return 1
	}
	grep -Fq -- "$config" <<<"$cmd" || {
		echo "$name invocation does not reference expected config" >&2
		return 1
	}
	tmp="$record.tmp.$$"
	{
		printf 'pid=%s\n' "$pid"
		printf 'pgid=%s\n' "$pgid"
		printf 'exe=%s\n' "$(proc_exe "$pid")"
		printf 'config=%s\n' "$config"
		printf 'cmdline=%s\n' "$cmd"
	} >"$tmp"
	mv -f "$tmp" "$record"
}

read_record() {
	local name=$1 record key value
	record=$(record_path "$name")
	[[ -r "$record" ]] || return 1
	unset pid pgid exe config cmdline
	while IFS='=' read -r key value; do
		case "$key" in pid | pgid | exe | config | cmdline) printf -v "$key" '%s' "$value" ;; esac
	done <"$record"
	[[ "$pid" =~ ^[0-9]+$ && "$pgid" =~ ^[0-9]+$ && -n "$exe" && -n "$config" && -n "$cmdline" ]]
}

verify_record() {
	local name=$1
	read_record "$name" || return 1
	[[ -d "/proc/$pid" && "$(proc_pgid "$pid")" == "$pgid" ]] || return 1
	[[ "$(proc_exe "$pid")" == "$exe" && "$(proc_cmdline "$pid")" == "$cmdline" ]] || return 1
	grep -Fq -- "$config" <<<"$cmdline"
}

start_one() {
	local name=$1 exe=$2 config=$3 log=$4 pid
	exe=$(command -v "$exe") || {
		echo "Missing executable for $name: $2" >&2
		return 1
	}
	if [[ -e "$(record_path "$name")" ]] && verify_record "$name"; then
		echo "$name is already running (pid $pid)"
		return 0
	fi
	rm -f "$(record_path "$name")"
	case "$name" in
	caddy) setsid "$exe" run --config "$config" --adapter caddyfile >>"$log" 2>&1 & ;;
	dnsmasq) setsid "$exe" --keep-in-foreground --conf-file="$config" --log-facility=- >>"$log" 2>&1 & ;;
	esac
	pid=$!
	for _ in {1..20}; do
		if [[ -d "/proc/$pid" ]] && [[ "$(proc_exe "$pid")" == "$(readlink -f "$exe")" ]]; then break; fi
		sleep 0.05
	done
	write_record "$name" "$pid" "$exe" "$config" || {
		local failed_pgid
		failed_pgid=$(proc_pgid "$pid")
		if [[ "$failed_pgid" =~ ^[0-9]+$ && "$failed_pgid" != 0 ]]; then
			kill -TERM -- "-$failed_pgid" 2>/dev/null || true
		fi
		return 1
	}
}

stop_one() {
	local name=$1
	if ! verify_record "$name"; then
		rm -f "$(record_path "$name")"
		echo "$name is not running (or its record is stale)"
		return 0
	fi
	local target_pid=$pid target_pgid=$pgid
	kill -TERM -- "-$target_pgid"
	for _ in {1..40}; do
		kill -0 "$target_pid" 2>/dev/null || break
		sleep 0.05
	done
	if kill -0 "$target_pid" 2>/dev/null; then
		verify_record "$name" || {
			echo "Refusing escalation: $name identity changed" >&2
			return 1
		}
		kill -KILL -- "-$target_pgid"
	fi
	rm -f "$(record_path "$name")"
}

validate_runtime() {
	require_command caddy
	require_command dnsmasq
	require_command curl
	[[ -s "$GENERATED/dnsmasq.conf" && -s "$GENERATED/Caddyfile" ]] || {
		echo "Run netbootctl render first." >&2
		return 1
	}
	dnsmasq --test --conf-file="$GENERATED/dnsmasq.conf"
	caddy validate --config "$GENERATED/Caddyfile" --adapter caddyfile
}

status_services() {
	local name state
	for name in caddy dnsmasq; do
		if verify_record "$name"; then state="running pid=$pid pgid=$pgid"; else state=stopped; fi
		printf '%-8s %s\n' "$name" "$state"
	done
}

start_services() {
	need_root start
	prepare_runtime
	render_config
	validate_runtime
	start_one caddy "$NETBOOT_CADDY_EXECUTABLE" "$GENERATED/Caddyfile" "$NETBOOT_CADDY_LOG"
	start_one dnsmasq "$NETBOOT_DNSMASQ_EXECUTABLE" "$GENERATED/dnsmasq.conf" "$NETBOOT_DNSMASQ_LOG"
	status_services
}

stop_services() {
	need_root stop
	stop_one dnsmasq
	stop_one caddy
}
logs() { tail -n 100 -F "$NETBOOT_CADDY_LOG" "$NETBOOT_DNSMASQ_LOG"; }

main() {
	local action=${1:-help}
	shift || true
	case "$action" in
	render)
		prepare_runtime
		render_config
		;;
	start)
		[[ $# == 0 ]] || {
			usage >&2
			return 2
		}
		start_services
		;;
	stop)
		[[ $# == 0 ]] || {
			usage >&2
			return 2
		}
		stop_services
		;;
	restart)
		[[ $# == 0 ]] || {
			usage >&2
			return 2
		}
		stop_services || true
		start_services
		;;
	reload)
		need_root reload
		prepare_runtime
		render_config
		validate_runtime
		if verify_record caddy; then
			caddy reload --config "$GENERATED/Caddyfile" --adapter caddyfile
		else
			start_one caddy "$NETBOOT_CADDY_EXECUTABLE" "$GENERATED/Caddyfile" "$NETBOOT_CADDY_LOG"
		fi
		stop_one dnsmasq
		start_one dnsmasq "$NETBOOT_DNSMASQ_EXECUTABLE" "$GENERATED/dnsmasq.conf" "$NETBOOT_DNSMASQ_LOG"
		;;
	status) status_services ;;
	logs) logs ;;
	tui) exec python3 "$SCRIPT_DIR/netboot-tui.py" "$@" ;;
	help | -h | --help) usage ;;
	*)
		echo "netbootctl: unknown command '$action'" >&2
		usage >&2
		return 2
		;;
	esac
}
main "$@"
