# Host settings shared by the repository's shell scripts.
#
# This is the authoritative configuration for the standalone service runtime.

# Host identity and project location.
NETBOOT_PROJECT_ROOT=/srv/netboot
NETBOOT_INTERFACE=eno1
NETBOOT_SERVER_IP=192.168.1.2
NETBOOT_SUBNET=192.168.1.0/24
NETBOOT_SERVER_ADDRESS=192.168.1.2/24
NETBOOT_GATEWAY=192.168.1.1
NETBOOT_DNS=192.168.1.1
NETBOOT_NETWORK_CONNECTION=netboot-eno1
NETBOOT_DHCP_PROXY_RANGE=192.168.1.0

# Service endpoints and roots.
NETBOOT_DNSMASQ_UNIT=dnsmasq.service
NETBOOT_CADDY_UNIT=caddy.service
NETBOOT_DNSMASQ_PORT=0
NETBOOT_HTTP_PORT=80
NETBOOT_TFTP_PORT=69
NETBOOT_PXE_PROXY_PORT=4011
NETBOOT_HTTP_ROOT=/srv/netboot/http
NETBOOT_TFTP_ROOT=/srv/netboot/tftp
NETBOOT_CONTENT_OWNER=aslate
NETBOOT_TFTP_GROUP=tftp
NETBOOT_HTTP_GROUP=httpd
NETBOOT_RUNTIME_ROOT=/srv/netboot/.runtime
NETBOOT_GENERATED_ROOT=/srv/netboot/.runtime/generated
NETBOOT_LOG_ROOT=/srv/netboot/.runtime/logs

# PXE handoff: proxy-DHCP, UEFI x86_64 and Legacy BIOS bootstraps, then iPXE.
NETBOOT_DHCP_MODE=proxy
NETBOOT_UEFI_BOOTSTRAP=ipxe.efi
NETBOOT_BIOS_BOOTSTRAP=undionly.kpxe
NETBOOT_IPXE_MENU_URL=http://192.168.1.2/menu/main.ipxe
NETBOOT_DHCP_RANGE_START=192.168.1.100
NETBOOT_DHCP_RANGE_END=192.168.1.200
NETBOOT_DHCP_LEASE_TIME=12h
NETBOOT_DHCP_GATEWAY=192.168.1.1
NETBOOT_DHCP_DNS=192.168.1.1
NETBOOT_DHCP_LEASE_FILE=/srv/netboot/.runtime/dnsmasq.leases

# Project-owned source configuration and installed destinations.
NETBOOT_DNSMASQ_CONFIG_SOURCE=/srv/netboot/config/dnsmasq.conf
NETBOOT_CADDY_CONFIG_SOURCE=/srv/netboot/config/Caddyfile
NETBOOT_DNSMASQ_CONFIG_RUNTIME=/srv/netboot/.runtime/generated/dnsmasq.conf
NETBOOT_CADDY_CONFIG_RUNTIME=/srv/netboot/.runtime/generated/Caddyfile
NETBOOT_DNSMASQ_PIDFILE=/srv/netboot/.runtime/dnsmasq.pid
NETBOOT_CADDY_PIDFILE=/srv/netboot/.runtime/caddy.pid
NETBOOT_DNSMASQ_LOG=/srv/netboot/.runtime/logs/dnsmasq.log
NETBOOT_CADDY_LOG=/srv/netboot/.runtime/logs/caddy.log
NETBOOT_DNSMASQ_EXECUTABLE=dnsmasq
NETBOOT_CADDY_EXECUTABLE=caddy
