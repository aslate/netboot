#!ipxe

dhcp

set base http://192.168.1.2/clonezilla
set squashfs ${base}/filesystem.squashfs

initrd --name initrd.img ${base}/initrd.img
kernel ${base}/vmlinuz initrd=initrd.img boot=live username=user union=overlay config components quiet noswap edd=on nomodeset nodmraid locales= keyboard-layouts= ocs_live_run="ocs-live-general" ocs_live_extra_param="" ocs_live_batch=no net.ifnames=0 nosplash noprompt fetch=${squashfs}

imgstat
boot
