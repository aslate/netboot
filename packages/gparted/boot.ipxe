#!ipxe

dhcp

set base http://192.168.1.2/gparted
set squashfs ${base}/filesystem.squashfs

initrd --name initrd.img ${base}/initrd.img
kernel ${base}/vmlinuz initrd=initrd.img boot=live union=overlay username=user config components loglevel=3 noswap net.ifnames=0 nosplash fetch=${squashfs}

imgstat
boot
